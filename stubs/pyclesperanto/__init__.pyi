"""What arraybridge calls of pyclesperanto."""

import numpy

class Device:
    name: str

class Array:
    shape: tuple[int, ...]
    dtype: numpy.dtype
    device: Device
    def __setitem__(self, index: int, value: Array) -> None: ...

def list_available_devices(device_type: str = ...) -> list[Device]: ...
def select_device(device_name: str | int = ..., device_type: str = ...) -> Device: ...
def get_device() -> Device: ...
def create(shape: tuple[int, ...], dtype: object = ..., device: Device = ...) -> Array: ...
def create_like(array: Array) -> Array: ...
def copy(input_image: Array, output_image: Array) -> Array: ...
def copy_slice(input_image: Array, output_image: Array, slice_index: int) -> Array: ...
def push(array: numpy.ndarray) -> Array: ...
def pull(array: Array) -> numpy.ndarray: ...
def set(input_image: Array, *, scalar: float, device: Device = ...) -> Array: ...
def concatenate_along_z(input_image0: Array, input_image1: Array) -> Array: ...
def maximum_z_projection(input_image: Array) -> Array: ...
def minimum_z_projection(input_image: Array) -> Array: ...
def mean_z_projection(input_image: Array) -> Array: ...
def sum_z_projection(input_image: Array) -> Array: ...
def minimum_of_all_pixels(input_image: Array) -> float: ...
def maximum_of_all_pixels(input_image: Array) -> float: ...
def subtract_image_from_scalar(input_image: Array, *, scalar: float) -> Array: ...
def multiply_image_and_scalar(input_image: Array, *, scalar: float) -> Array: ...
