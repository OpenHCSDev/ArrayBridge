"""What arraybridge calls of TensorFlow."""

from collections.abc import Sequence
from contextlib import AbstractContextManager

import numpy
from typing_extensions import Self

from . import config as config
from . import dtypes as dtypes
from . import experimental as experimental
from . import math as math

_Axis = int | tuple[int, ...]

__version__: str

float16: dtypes.DType
float32: dtypes.DType
float64: dtypes.DType

class TensorShape:
    def num_elements(self) -> int: ...
    def __getitem__(self, index: int) -> int: ...

class Tensor:
    device: str
    shape: TensorShape
    dtype: dtypes.DType
    def numpy(self) -> numpy.ndarray: ...
    def __getitem__(self, index: int | slice) -> Self: ...
    def __sub__(self, other: Self | float) -> Self: ...
    def __mul__(self, other: float) -> Self: ...
    def __truediv__(self, other: Self | float) -> Self: ...
    def __le__(self, other: Self) -> Self: ...

def device(device_name: str) -> AbstractContextManager[None]: ...
def identity(input: Tensor) -> Tensor: ...
def convert_to_tensor(value: numpy.ndarray) -> Tensor: ...
def cast(x: Tensor, dtype: dtypes.DType) -> Tensor: ...
def reduce_max(input_tensor: Tensor, axis: _Axis | None = ...) -> Tensor: ...
def reduce_min(input_tensor: Tensor, axis: _Axis | None = ...) -> Tensor: ...
def reduce_mean(input_tensor: Tensor, axis: _Axis | None = ...) -> Tensor: ...
def reduce_sum(input_tensor: Tensor, axis: _Axis | None = ...) -> Tensor: ...
def linspace(start: float, stop: float, num: int) -> Tensor: ...
def ones(shape: int | tuple[int, ...], dtype: dtypes.DType = ...) -> Tensor: ...
def range(start: int, limit: int, delta: int) -> Tensor: ...
def reshape(tensor: Tensor, shape: Sequence[int]) -> Tensor: ...
def tensor_scatter_nd_update(tensor: Tensor, indices: Tensor, updates: Tensor) -> Tensor: ...
def tensordot(a: Tensor, b: Tensor, axes: int) -> Tensor: ...
def clip_by_value(t: Tensor, clip_value_min: float, clip_value_max: float) -> Tensor: ...
def stack(values: Sequence[Tensor], axis: int = ...) -> Tensor: ...
def logical_and(x: Tensor, y: Tensor) -> Tensor: ...
def broadcast_to(input: Tensor, shape: tuple[int, ...]) -> Tensor: ...
