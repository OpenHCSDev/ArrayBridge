"""What arraybridge calls of ``jax.numpy``."""

from collections.abc import Callable, Sequence

from jax import Array, Device

ndarray = Array

_Axis = int | tuple[int, ...]

class _ScalarType: ...

float16: _ScalarType
float32: _ScalarType
float64: _ScalarType

def clip(arr: Array, min: float, max: float) -> Array: ...
def max(a: Array, axis: _Axis | None = ...) -> Array: ...
def min(a: Array, axis: _Axis | None = ...) -> Array: ...
def mean(a: Array, axis: _Axis | None = ...) -> Array: ...
def sum(a: Array, axis: _Axis | None = ...) -> Array: ...
def linspace(start: float, stop: float, num: int, *, endpoint: bool = ...) -> Array: ...
def ones(
    shape: int | tuple[int, ...],
    dtype: object = ...,
    *,
    device: Device | Callable[[], Device] = ...,
) -> Array: ...
def outer(a: Array, b: Array) -> Array: ...
def floor(x: float) -> Array: ...
def stack(arrays: Sequence[Array], axis: int = ...) -> Array: ...
def logical_and(x1: Array, x2: Array) -> Array: ...
def broadcast_to(array: Array, shape: tuple[int, ...]) -> Array: ...
