"""What arraybridge calls of PyTorch."""

import builtins
from collections.abc import Sequence

import numpy
from typing_extensions import Self

from . import cuda as cuda

_Axis = int | tuple[int, ...]

class dtype: ...

_DType = dtype

uint16: dtype
float16: dtype
float32: dtype
float64: dtype

class device:
    index: int

class Tensor:
    device: device
    is_cuda: bool
    dtype: _DType
    def to(self, device: str | _DType = ..., *, dtype: _DType = ...) -> Self: ...
    def cpu(self) -> Self: ...
    def float(self) -> Self: ...
    def numpy(self) -> numpy.ndarray: ...
    def element_size(self) -> int: ...
    def nelement(self) -> int: ...
    def min(self) -> Self: ...
    def max(self) -> Self: ...
    def reshape(self, shape: tuple[int, ...]) -> Self: ...
    def expand(self, size: tuple[int, ...]) -> Self: ...
    def __getitem__(self, index: int | slice) -> Self: ...
    def __sub__(self, other: Self | builtins.float) -> Self: ...
    def __mul__(self, other: builtins.float) -> Self: ...
    def __truediv__(self, other: Self | builtins.float) -> Self: ...
    def __le__(self, other: Self) -> Self: ...

def from_numpy(ndarray: numpy.ndarray) -> Tensor: ...
def from_dlpack(ext_tensor: object) -> Tensor: ...
def tensor(data: float) -> Tensor: ...
def amax(input: Tensor, dim: _Axis) -> Tensor: ...
def amin(input: Tensor, dim: _Axis) -> Tensor: ...
def mean(input: Tensor, dim: _Axis) -> Tensor: ...
def sum(input: Tensor, dim: _Axis) -> Tensor: ...
def linspace(start: float, end: float, steps: int, *, dtype: dtype = ...) -> Tensor: ...
def ones(size: int | tuple[int, ...], *, dtype: dtype = ..., device: device = ...) -> Tensor: ...
def outer(input: Tensor, vec2: Tensor) -> Tensor: ...
def floor(input: Tensor) -> Tensor: ...
def clamp(input: Tensor, *, min: float, max: float) -> Tensor: ...
def stack(tensors: Sequence[Tensor], dim: int = ...) -> Tensor: ...
def logical_and(input: Tensor, other: Tensor) -> Tensor: ...
