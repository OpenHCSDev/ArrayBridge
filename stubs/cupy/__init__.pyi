"""What arraybridge calls of CuPy."""

from collections.abc import Sequence

import numpy
from typing_extensions import Self

from . import cuda as cuda

_Axis = int | tuple[int, ...]

class floating: ...

class ndarray:
    shape: tuple[int, ...]
    dtype: numpy.dtype
    device: cuda.Device
    def astype(self, dtype: object, *, copy: bool = ...) -> Self: ...
    def reshape(self, shape: tuple[int, ...]) -> Self: ...
    def copy(self) -> Self: ...
    def get(self) -> numpy.ndarray: ...
    def __getitem__(self, index: int | slice) -> Self: ...
    def __setitem__(self, index: int | slice, value: Self) -> None: ...
    def __sub__(self, other: Self | float) -> Self: ...
    def __mul__(self, other: float) -> Self: ...
    def __truediv__(self, other: Self | float) -> Self: ...
    def __itruediv__(self, other: Self | float) -> Self: ...
    def __le__(self, other: Self) -> Self: ...

class _MemoryPool:
    def free_all_blocks(self) -> None: ...

def get_default_memory_pool() -> _MemoryPool: ...
def get_default_pinned_memory_pool() -> _MemoryPool: ...
def from_dlpack(array: object) -> ndarray: ...

# Present only in CuPy releases that still read bare capsules.
def fromDlpack(dltensor: object) -> ndarray: ...
def issubdtype(arg1: object, arg2: object) -> bool: ...
def array(a: numpy.ndarray | ndarray, *, dtype: object = ..., copy: bool = ...) -> ndarray: ...
def clip(a: ndarray, a_min: float, a_max: float) -> ndarray: ...
def max(a: ndarray, axis: _Axis | None = ...) -> ndarray: ...
def min(a: ndarray, axis: _Axis | None = ...) -> ndarray: ...
def mean(a: ndarray, axis: _Axis | None = ...) -> ndarray: ...
def sum(a: ndarray, axis: _Axis | None = ...) -> ndarray: ...
def linspace(start: float, stop: float, num: int, *, endpoint: bool = ...) -> ndarray: ...
def ones(shape: int | tuple[int, ...], dtype: object = ...) -> ndarray: ...
def outer(a: ndarray, b: ndarray) -> ndarray: ...
def floor(x: float) -> ndarray: ...
def stack(arrays: Sequence[ndarray], axis: int = ...) -> ndarray: ...
def logical_and(x1: ndarray, x2: ndarray) -> ndarray: ...
def broadcast_to(array: ndarray, shape: tuple[int, ...]) -> ndarray: ...
